# Prevent execution of executable scripts in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|pht|phar|cgi|pl|py|sh|bash|exe)$">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI

